<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>schnickschnackschnuck</groupId>
  <artifactId>yoda-conditions-recipe</artifactId>
  <version>1.0.0</version>
  <name>Yoda conditions OpenRewrite recipe</name>
  <description>
    An OpenRewrite recipe that rewrites comparisons inside `if` conditions into Yoda style.
    rewrite-static-analysis 2.41.0 has no Yoda recipe in either direction, so this fills the gap.

    Deliberately NOT a module of the parent build: the parent is a single-module project and
    `mvn clean test` at the root must stay unaffected. Build and run it explicitly:

      mvn -f tools/yoda-conditions-recipe/pom.xml install
      mvn -Drewrite.recipeArtifactCoordinates=schnickschnackschnuck:yoda-conditions-recipe:1.0.0 \
          -Drewrite.activeRecipes=schnickschnackschnuck.rewrite.YodaConditions \
          org.openrewrite.maven:rewrite-maven-plugin:6.46.1:run
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <rewrite.version>8.89.0</rewrite.version>
    <junit.jupiter.version>5.14.4</junit.jupiter.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${rewrite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-25</artifactId>
      <version>${rewrite.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-test</artifactId>
      <version>${rewrite.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
    </plugins>
  </build>
</project>
